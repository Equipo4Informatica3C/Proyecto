/* ----- General ----- */
* {
    box-sizing: border-box; /* el padding y el borde no agrandan las cajas */
}

body {
    margin: 0;
    padding: 0;
    background-color: #f5f1e6;
    color: #222222;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 17px;
    line-height: 1.6;
}

h1, h2, h3 {
    font-family: Georgia, "Times New Roman", serif;
    color: #1f3a5f;
}

a {
    color: #1f3a5f;
}

a:hover {
    color: #c9a227;
}

/* ----- Encabezado y menú ----- */
header {
    background-color: #1f3a5f;
    color: #ffffff;
    text-align: center;
    padding: 30px 20px 10px 20px;
    border-bottom: 5px solid #c9a227;
}

header h1 {
    color: #ffffff;
    margin: 0 0 10px 0;
    font-size: 36px;
}

header p {
    margin: 5px 0;
}

nav ul {
    list-style: none;
    margin: 20px 0 0 0;
    padding: 0;
}

nav li {
    display: inline-block;
    margin: 0 4px 10px 4px;
}

nav a {
    display: block;
    padding: 8px 14px;
    color: #ffffff;
    text-decoration: none;
    border: 1px solid #c9a227;
    border-radius: 5px;
}

nav a:hover {
    background-color: #c9a227;
    color: #1f3a5f;
}

/* ----- Contenido principal ----- */
main {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
}

main section {
    background-color: #ffffff;
    margin-bottom: 25px;
    padding: 20px 25px;
    border: 1px solid #d8d2bf;
    border-left: 6px solid #c9a227;
    border-radius: 6px;
}

main h2 {
    margin-top: 0;
    border-bottom: 2px solid #c9a227;
    padding-bottom: 5px;
}

/* ----- Imágenes ----- */
figure {
    margin: 15px auto;
    text-align: center;
}

img {
    max-width: 100%;
    height: auto;
    border: 3px solid #1f3a5f;
    border-radius: 6px;
}

figcaption {
    font-size: 14px;
    font-style: italic;
    color: #555555;
    margin-top: 5px;
}

/* ----- Nota, cita y ficha ----- */
aside {
    background-color: #fff8dc;
    border: 1px solid #c9a227;
    padding: 5px 15px;
    margin: 15px 0;
    border-radius: 5px;
}

blockquote {
    margin: 15px 0;
    padding: 10px 20px;
    background-color: #eef2f8;
    border-left: 5px solid #1f3a5f;
    font-size: 20px;
    font-style: italic;
}

.ficha dt {
    font-weight: bold;
    color: #1f3a5f;
    margin-top: 10px;
}

.ficha dd {
    margin-left: 20px;
}

/* ----- Tabla ----- */
table {
    width: 100%;
    border-collapse: collapse;
}

caption {
    font-weight: bold;
    padding: 8px;
    color: #1f3a5f;
}

th, td {
    border: 1px solid #bbbbbb;
    padding: 8px 10px;
    text-align: left;
}

th {
    background-color: #1f3a5f;
    color: #ffffff;
}

tbody tr:nth-child(even) {
    background-color: #f5f1e6;
}

/* ----- Trivia ----- */
.pregunta {
    margin-bottom: 15px;
    padding: 10px 15px;
    border: 2px solid #c9a227;
    border-radius: 6px;
}

.pregunta legend {
    font-weight: bold;
    color: #1f3a5f;
    padding: 0 8px;
}

.pregunta.correcta {
    background-color: #e3f4e3;
    border-color: #2e8b3d;
}

.pregunta.incorrecta {
    background-color: #fbe4e4;
    border-color: #c0392b;
}

.feedback {
    margin: 10px 0 0 0;
    font-weight: bold;
}

button {
    background-color: #1f3a5f;
    color: #ffffff;
    border: none;
    padding: 10px 20px;
    margin-right: 10px;
    font-size: 16px;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background-color: #c9a227;
    color: #1f3a5f;
}

#resultado {
    margin-top: 15px;
    font-size: 20px;
    font-weight: bold;
    color: #1f3a5f;
}

/* ----- Pie de página ----- */
footer {
    background-color: #1f3a5f;
    color: #ffffff;
    text-align: center;
    padding: 15px;
    border-top: 5px solid #c9a227;
}

footer p {
    margin: 5px 0;
}
